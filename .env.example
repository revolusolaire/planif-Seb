# ─────────────────────────────────────────────────────────────
# CRM RevoluSolaire — Configuration
# Copie ce fichier en .env et remplis tes valeurs
# cp .env.example backend/.env
# ─────────────────────────────────────────────────────────────

# URL de l'application (pour les liens dans les alertes Telegram)
APP_URL=http://72.62.233.55:58645

# ── Google Sheets ─────────────────────────────────────────────
# IDs des Google Sheets à surveiller (séparés par virgule)
# L'ID se trouve dans l'URL : docs.google.com/spreadsheets/d/<ID>/
GOOGLE_SHEET_IDS=1oCDvqRenNx1rmaXEQ-MMwde3-RjQbccdoynvX-Wypp8

# Chemin vers le fichier JSON du compte de service Google
GOOGLE_CREDENTIALS_FILE=google_credentials.json

# Noms des colonnes dans le Google Sheet (correspondent au sheet Meta actuel)
COL_PRENOM=Prénom
COL_NOM=Nom
COL_TEL=N° de tel
COL_EMAIL=Email
COL_CAMPAGNE=
COL_ENTREPRISE=Entreprise
COL_DEMANDE=Demande
COL_HORAIRES=Horaires pour rappel
COL_REMARQUES=Remarques

# ── Telegram ──────────────────────────────────────────────────
# Token de ton bot Telegram (obtenu via @BotFather)
TELEGRAM_BOT_TOKEN=TON_TOKEN_ICI

# Ton Chat ID Telegram (envoie /start à @userinfobot pour l'obtenir)
TELEGRAM_CHAT_ID=TON_CHAT_ID_ICI

# ── Email (Gmail) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=revolusolaire@gmail.com
# Mot de passe d'application Gmail (pas ton mot de passe principal)
# Génère-en un ici : myaccount.google.com/apppasswords
SMTP_PASSWORD=TON_MOT_DE_PASSE_APPLICATION

FROM_NAME=RevoluSolaire

# ── Agent email IA (optionnel) ────────────────────────────────
# Clé API Anthropic pour personnaliser les emails de relance avec Claude
# Sans cette clé, le template statique est utilisé (aucune fonctionnalité perdue)
# Obtenir une clé : https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Base de données ───────────────────────────────────────────
# SQLite par défaut (le fichier crm.db sera créé automatiquement)
DATABASE_URL=sqlite:///./crm.db
